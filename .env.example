# Lively Stones Platform Environment Variables
# Copy this file to .env and replace with your actual keys

# Supabase Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# YouVersion Platform API Key
# Register your application at https://platform.youversion.com to obtain an App Key
YVP_APP_KEY=your-youversion-app-key
VITE_YVP_APP_KEY=your-youversion-app-key
